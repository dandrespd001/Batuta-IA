{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batuta.local/specs/schemas/evidence-record-v2.schema.json",
  "title": "EvidenceRecordV2",
  "description": "Registro cerrado de evidencia nueva, separado del legado V1 inmutable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "task_id",
    "requirement_ids",
    "evidence_mode",
    "spec_snapshot",
    "red",
    "green",
    "mutation",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{3}$"
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]{3}$"
      }
    },
    "evidence_mode": {
      "enum": [
        "tdd",
        "reconstructed_audit"
      ]
    },
    "spec_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/evidence/specs/[0-9a-f]{64}\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "red": {
      "$ref": "#/$defs/command"
    },
    "green": {
      "$ref": "#/$defs/command"
    },
    "mutation": {
      "$ref": "#/$defs/mutation"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "summary"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "summary",
        "killed"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "killed": {
          "const": true
        }
      }
    }
  }
}
