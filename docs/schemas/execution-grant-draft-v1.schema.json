{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batuta.local/schemas/execution-grant-draft-v1.schema.json",
  "title": "ExecutionGrantDraftV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "issued_at",
    "expires_at",
    "manifest_hash",
    "routes",
    "actions",
    "operations",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "issued_at": { "type": "integer", "minimum": 0 },
    "expires_at": { "type": "integer", "minimum": 1 },
    "manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["route", "run", "research", "canary"] }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "input_tokens", "output_tokens", "wall_time_ms"],
      "properties": {
        "requests": { "type": "integer", "minimum": 1 },
        "input_tokens": { "type": "integer", "minimum": 1 },
        "output_tokens": { "type": "integer", "minimum": 1 },
        "wall_time_ms": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
