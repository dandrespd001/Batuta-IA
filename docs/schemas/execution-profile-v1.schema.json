{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batuta.local/schemas/execution-profile-v1.schema.json",
  "title": "ExecutionProfileV1 draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workdir",
    "max_stdout_bytes",
    "max_stderr_bytes",
    "termination_grace_ms"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workdir": { "type": "string", "minLength": 1 },
    "max_stdout_bytes": { "type": "integer", "minimum": 1 },
    "max_stderr_bytes": { "type": "integer", "minimum": 1 },
    "termination_grace_ms": { "type": "integer", "minimum": 1 }
  }
}
